{
  "version": 1,
  "categories": [
    {
      "id": "ai-claude-code",
      "section": "AI tools",
      "title": "Claude Code",
      "detail": "Debug logs, shell snapshots, telemetry and caches. Files touched in the last 24 hours are kept so active sessions are not affected.",
      "risk": "safe",
      "autoSelect": true,
      "minAgeHours": 24,
      "icon": "terminal",
      "tint": "teal",
      "targets": [
        {
          "path": "~/.claude/debug/*"
        },
        {
          "path": "~/.claude/shell-snapshots/*"
        },
        {
          "path": "~/.claude/telemetry/*"
        },
        {
          "path": "~/.claude/cache/*"
        },
        {
          "path": "~/Library/Caches/claude-cli-nodejs/*"
        }
      ]
    },
    {
      "id": "ai-claude-temp",
      "section": "AI tools",
      "title": "Claude Code temporary folders",
      "detail": "Per-session scratch folders in /tmp. Only folders older than 24 hours are listed.",
      "risk": "review",
      "autoSelect": false,
      "minAgeHours": 24,
      "icon": "terminal",
      "tint": "teal",
      "targets": [
        {
          "path": "/private/tmp/claude-*"
        }
      ]
    },

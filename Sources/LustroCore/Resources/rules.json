    },
    {
      "id": "system-user-caches",
      "section": "System",
      "title": "App caches",
      "detail": "Files apps keep to load faster. Apps recreate them as needed. Caches of iCloud, sync clients (Dropbox, OneDrive, Google Drive) and system services that hold state are excluded.",
      "risk": "safe",
      "autoSelect": true,
      "icon": "laptopcomputer",
      "tint": "blue",
      "targets": [
        {
          "path": "~/Library/Caches/*",
          "exclude": [
            "com.apple.nsurlsessiond",
            "com.apple.bird",
            "com.apple.cloudd",
            "CloudKit",
            "com.apple.CloudKit*",
            "com.apple.icloud*",
            "com.apple.iCloudHelper",
            "com.apple.akd",
            "com.apple.TrustedPeersHelper",
            "FamilyCircle",
            "com.apple.containermanagerd",
            "com.apple.ap.adprivacyd",
            "com.apple.HomeKit",
            "com.apple.homed",
            "com.apple.findmy*",
            "com.apple.passd",
            "com.apple.ScreenTimeAgent",
            "com.apple.Safari.SafeBrowsing",
            "*OneDrive*",
            "com.getdropbox*",
            "com.dropbox*",
            "*DriveFS*",
            "com.google.drivefs*",
            "com.box.desktop*",
            "io.github.guiboorges.lustro*"
          ]
        }
      ]
    },
    {
      "id": "system-sandbox-caches",
      "section": "System",
      "title": "Sandboxed app caches",
      "detail": "Caches inside App Store and sandboxed app containers. Requires Full Disk Access.",
      "risk": "safe",
      "autoSelect": true,
      "requiresFullDiskAccess": true,
      "icon": "square.dashed",
      "tint": "blue",
      "targets": [
        {
          "path": "~/Library/Containers/*/Data/Library/Caches/*"
        }
      ]
    },
    {
      "id": "system-user-logs",
      "section": "System",
      "title": "Log files",
      "detail": "Logs written by apps. Only useful when diagnosing a problem.",
      "risk": "safe",
      "autoSelect": true,
      "icon": "doc.text",
      "tint": "blue",
      "targets": [
        {
          "path": "~/Library/Logs/*",
          "exclude": [
            "DiagnosticReports"
          ]
        },
        {
          "path": "~/Library/Logs/DiagnosticReports/*"
        }
      ]
    },
    {
      "id": "system-sandbox-logs",
      "section": "System",
      "title": "Sandboxed app logs",
      "detail": "Logs inside app containers. Requires Full Disk Access.",
      "risk": "safe",
      "autoSelect": true,
      "requiresFullDiskAccess": true,
      "icon": "doc.text",
      "tint": "blue",
      "targets": [
        {
          "path": "~/Library/Containers/*/Data/Library/Logs/*"
        }
      ]
    },
    {
      "id": "system-mail-downloads",
      "section": "System",
      "title": "Mail downloads",
      "detail": "Copies of attachments you opened from Mail. The originals stay in your mailbox. Requires Full Disk Access.",
      "risk": "review",
      "autoSelect": true,
      "requiresFullDiskAccess": true,
      "owners": [
        "com.apple.mail"
      ],
      "icon": "envelope",
      "tint": "blue",
      "targets": [
        {
          "path": "~/Library/Containers/com.apple.mail/Data/Library/Mail Downloads/*"
        }
      ]
    },
    {
      "id": "system-ios-updates",
      "section": "System",
      "title": "iOS and iPadOS update files",
      "detail": "Firmware files downloaded to update devices. Downloaded again if needed.",
      "risk": "safe",
      "autoSelect": true,
      "icon": "arrow.down.circle",
      "tint": "blue",
      "targets": [
        {
          "path": "~/Library/iTunes/iPhone Software Updates/*.ipsw"
        },
        {
          "path": "~/Library/iTunes/iPad Software Updates/*.ipsw"
        }
      ]
    },
    {
      "id": "system-ios-backups",
      "section": "System",
      "title": "iPhone and iPad backups",
      "detail": "Local device backups. The newest backup of each device is always kept; older ones are listed. Requires Full Disk Access.",
      "risk": "caution",
      "autoSelect": false,
      "requiresFullDiskAccess": true,
      "keepNewestPerDevice": true,
      "icon": "iphone",
      "tint": "red",
      "targets": [
        {
          "path": "~/Library/Application Support/MobileSync/Backup/*"
        }
      ]
    },
    {
      "id": "system-installers",
      "section": "System",
      "title": "Installers in Downloads",
      "detail": "Disk images and installer packages in your Downloads folder.",
      "risk": "review",
      "autoSelect": false,
      "icon": "opticaldiscdrive",
      "tint": "blue",
      "targets": [
        {
          "path": "~/Downloads/*.dmg"
        },
        {
          "path": "~/Downloads/*.pkg"
        },
        {
          "path": "~/Downloads/*.mpkg"
        }
      ]
    },
    {
      "id": "trash",
      "section": "Trash",
      "title": "Trash",
      "detail": "Items already in your Trash. Emptying the Trash is always permanent.",
      "risk": "review",
      "autoSelect": false,
      "icon": "trash",
      "tint": "gray",
      "targets": [
        {
          "path": "~/.Trash/*"
        }
      ]
    }
  ]

    {
      "id": "dev-package-caches",
      "section": "Developer tools",
      "title": "Package manager caches",
      "detail": "Downloaded packages kept by Homebrew, npm, Yarn, pip, Poetry, Bun, Deno, CocoaPods, Cargo and Go. Safe to remove, but they are downloaded again the next time a project needs them.",
      "risk": "review",
      "autoSelect": false,
      "icon": "shippingbox",
      "tint": "orange",
      "targets": [
        {
          "path": "~/Library/Caches/Homebrew/*"
        },
        {
          "path": "~/.npm/_cacache"
        },
        {
          "path": "~/.npm/_logs"
        },
        {
          "path": "~/Library/Caches/Yarn"
        },
        {
          "path": "~/.yarn/berry/cache"
        },
        {
          "path": "~/Library/Caches/pip"
        },
        {
          "path": "~/Library/Caches/pypoetry"
        },
        {
          "path": "~/.bun/install/cache"
        },
        {
          "path": "~/Library/Caches/deno"
        },
        {
          "path": "~/Library/Caches/CocoaPods"
        },
        {
          "path": "~/.cargo/registry/cache"
        },
        {
          "path": "~/Library/Caches/go-build"
        }
      ]
    },
    {
      "id": "dev-large-dependency-stores",
      "section": "Developer tools",
      "title": "Shared dependency stores",
      "detail": "Global stores for pnpm, uv, Go modules, Gradle and Maven. Safe to remove, but every project downloads its dependencies again.",
      "risk": "review",
      "autoSelect": false,
      "icon": "square.stack.3d.up",
      "tint": "orange",
      "targets": [
        {
          "path": "~/Library/pnpm/store"
        },
        {
          "path": "~/.cache/uv"
        },
        {
          "path": "~/go/pkg/mod"
        },
        {
          "path": "~/.gradle/caches"
        },
        {
          "path": "~/.m2/repository"
        },
        {
          "path": "~/.cargo/git/checkouts"
        }
      ]
    },
